# Copy to .env. Every variable is optional; the defaults run the agent with the free fake provider.

# LLM provider: fake (deterministic, free) | anthropic | bedrock
AGENT_PROVIDER=fake
AGENT_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=            # required for AGENT_PROVIDER=anthropic; never commit it
# AGENT_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1          # Bedrock uses the standard AWS credential chain

# Warehouse (read-only DuckDB). Build it with: uv run python scripts/build_demo_warehouse.py
AGENT_WAREHOUSE_PATH=data/demo_warehouse.duckdb
AGENT_ROW_LIMIT=200
AGENT_QUERY_TIMEOUT_SECONDS=20
AGENT_APPROVAL_ROW_THRESHOLD=100000

# API security. Comma-separated JSON list; empty list = no auth (local development only).
AGENT_API_KEYS=["change-me-local-key"]
AGENT_RATE_LIMIT=30/minute
AGENT_CORS_ORIGINS=[]

# Conversation memory: Postgres when set, in-process otherwise.
# AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=analyst-agent
AGENT_LOG_LEVEL=INFO

# Pricing used for the per-request cost figure (USD per million tokens; Haiku 4.5 list price)
AGENT_PRICE_INPUT_PER_MTOK=1.00
AGENT_PRICE_OUTPUT_PER_MTOK=5.00

# docker compose only
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
